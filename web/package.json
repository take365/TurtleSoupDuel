{
  "name": "turtlesoupduel-web",
  "private": true,
  "version": "0.1.0",
  "description": "TurtleSoupDuel Next.js frontend (App Router)",
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "lint": "next lint",
    "seed:invites": "node scripts/seed_invites.js",
    "seed:themes": "node scripts/seed_themes.js",
    "seed:all": "node scripts/seed_themes.js && node scripts/seed_invites.js",
    "show:samples": "node scripts/show_samples.js",
    "db:inspect": "node scripts/db_inspect.js",
    "db:import-themes": "node scripts/import_theme_json.js",
    "e2e:smoke": "node scripts/test_e2e_smoke.js"
  },
  "dependencies": {
    "next": "14.2.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "cassandra-driver": "4.7.2",
    "uuid": "9.0.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "autoprefixer": "10.4.19",
    "postcss": "8.4.38",
    "tailwindcss": "3.4.10",
    "typescript": "5.4.5",
    "@types/node": "20.14.2",
    "@types/react": "18.2.66",
    "@types/react-dom": "18.2.22"
  }
}
